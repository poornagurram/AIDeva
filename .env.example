# ---- Claude (https://platform.claude.com) ----
ANTHROPIC_API_KEY=

# ---- X API (https://console.x.com) - pay-per-use credits ----
# Create the developer app ON THE ACCOUNT THAT POSTS (cheaper "Owned Reads"), set app permissions to
# "Read and write" BEFORE generating the access token, then paste the 4 values below.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# oauth1 (default, tokens never expire) | oauth2 (auto-refreshing; bootstraps by exchanging the OAuth1 tokens)
X_AUTH_MODE=oauth1
X_OAUTH2_CLIENT_ID=
X_OAUTH2_CLIENT_SECRET=
X_OAUTH2_REFRESH_TOKEN=

# ---- Telegram (approvals, /note, alerts, daily report) ----
# Create a bot with @BotFather, send it any message, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Slack/Discord webhook for alerts and reports
NOTIFY_WEBHOOK_URL=

# ---- Runtime ----
XAGENT_CONFIG=config/agent.yaml
XAGENT_DATA_DIR=data
# 1 = never post, just log what would be posted (start here)
XAGENT_DRY_RUN=1
XAGENT_LOG_LEVEL=INFO
# Expose GET /healthz on this port (Railway/Render/Fly set PORT automatically)
# XAGENT_HEALTH_PORT=8080
